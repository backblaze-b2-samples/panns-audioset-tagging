  "info": {
    "description": "Local API for PANNs AudioSet Tagging: ingest audio clips to Backblaze B2, tag them locally with PANNs (527-class AudioSet labels + a 2048-dim embedding), and store every artifact \u2014 audio, per-clip tag JSON, and the labels_index.jsonl manifest \u2014 in B2 over the S3-compatible API. This contract documents the local API, not a hosted public endpoint.",
    "title": "PANNs AudioSet Tagging API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/files": {
      "get": {
        "operationId": "list_files_endpoint_files_get",
        "parameters": [
          {
            "in": "query",
            "name": "prefix",
            "required": false,
            "schema": {
              "default": "",
              "title": "Prefix",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FileMetadata"
                  },
                  "title": "Response List Files Endpoint Files Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Files Endpoint",
        "tags": [
          "files"
        ]
      }
    },
