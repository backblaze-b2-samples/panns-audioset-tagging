# Backblaze B2 (required) — S3-compatible API. The S3 endpoint is derived from
# B2_REGION (https://s3.<region>.backblazeb2.com), so there is no separate
# endpoint variable to set.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your-region

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=your-application-key-shown-once-in-b2
# B2_BUCKET_NAME=my-audio-corpus
# B2_REGION=us-west-004

# Optional: public base URL for the bucket (only if the bucket is public). When
# set, object responses include a direct public URL; leave unset otherwise.
# B2_PUBLIC_URL_BASE=https://my-audio-corpus.s3.us-west-004.backblazeb2.com

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
